e;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;fontFamily=Helvetica;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1274" y="696" width="130" height="78" as="geometry"/></mxCell><mxCell id="aqua" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#687078;dashed=1;strokeWidth=1.4;arcSize=6;fontFamily=Helvetica;container=0;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1490" y="480" width="195" height="100" as="geometry"/></mxCell><mxCell id="aqua-icon" value="" style="shape=image;aspect=fixed;imageAspect=1;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1502" y="509.0" width="42" height="42" as="geometry"/></mxCell><mxCell id="aqua-label" value="&lt;b&gt;Aqua Security&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#545B64&quot;&gt;registry scan and runtime&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;fontFamily=Helvetica;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1554" y="486" width="125" height="88" as="geometry"/></mxCell><mxCell id="datadog" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#687078;dashed=1;strokeWidth=1.4;arcSize=6;fontFamily=Helvetica;container=0;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1490" y="590" width="195" height="170" as="geometry"/></mxCell><mxCell id="datadog-icon" value="" style="shape=image;aspect=fixed;imageAspect=1;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1502" y="654.0" width="42" height="42" as="geometry"/></mxCell><mxCell id="datadog-label" value="&lt;b&gt;Datadog&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#545B64&quot;&gt;CPU, memory and pending task monitors&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;fontFamily=Helvetica;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1554" y="596" width="125" height="158" as="geometry"/></mxCell><mxCell id="step-1" value="&lt;span style=&quot;display:inline-block;box-sizing:border-box;width:19px;height:19px;border-radius:50%;text-align:center;line-height:19px;font-size:11px;font-weight:bold;vertical-align:middle;background:#FF9900;color:#232F3E;&quot;&gt;1&lt;/span&gt;&amp;nbsp; Terraform provisions the VPC, ECS cluster, ALB and the integrations enabled in tfvars." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;fontFamily=Helvetica;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="36" y="975" width="585" height="36" as="geometry"/></mxCell><mxCell id="step-2" value="&lt;span style=&quot;display:inline-block;box-sizing:border-box;width:19px;height:19px;border-radius:50%;text-align:center;line-height:19px;font-size:11px;font-weight:bold;vertical-align:middle;background:#FF9900;color:#232F3E;&quot;&gt;2&lt;/span&gt;&amp;nbsp; Users reach the public ALB on port 80, which forwards to tasks in the private subnets." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;fontFamily=Helvetica;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="36" y="1017" width="585" height="36" as="geometry"/></mxCell><mxCell id="step-3" value="&lt;span style=&quot;display:inline-block;box-sizing:border-box;width:19px;height:19px;border-radius:50%;text-align:center;line-height:19px;font-size:11px;font-weight:bold;vertical-align:middle;background:#FF9900;color:#232F3E;&quot;&gt;3&lt;/span&gt;&amp;nbsp; The ecsdemo service runs on Fargate and Fargate Spot, with ECS Exec enabled." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;fontFamily=Helvetica;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="36" y="1059" width="585" height="36" as="geometry"/></mxCell><mxCell id="step-4" value="&lt;span style=&quot;display:inline-block;box-sizing:border-box;width:19px;height:19px;border-radius:50%;text-align:center;line-height:19px;font-size:11px;font-weight:bold;vertical-align:middle;background:#FF9900;color:#232F3E;&quot;&gt;4&lt;/span&gt;&amp;nbsp; A push to the GitHub fork triggers CodePipeline through AWS CodeConnections." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;fontFamily=Helvetica;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="36" y="1101" width="585" height="36" as="geometry"/></mxCell><mxCell id="step-5" value="&lt;span style=&quot;display:inline-block;box-sizing:border-box;width:19px;height:19px;border-radius:50%;text-align:center;line-height:19px;font-size:11px;font-weight:bold;vertical-align:middle;background:#FF9900;color:#232F3E;&quot;&gt;5&lt;/span&gt;&amp;nbsp; CodeBuild runs the security scans in parallel, then lint and unit tests." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;fontFamily=Helvetica;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="36" y="1143" width="585" height="36" as="geometry"/></mxCell><mxCell id="step-6" value="&lt;span style=&quot;display:inline-block;box-sizing:border-box;width:19px;height:19px;border-radius:50%;text-align:center;line-height:19px;font-size:11px;font-weight:bold;vertical-align:middle;background:#FF9900;color:#232F3E;&quot;&gt;6&lt;/span&gt;&amp;nbsp; The image is pushed to ECR tagged from version.txt: bump it or the push fails." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;fontFamily=Helvetica;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="636" y="975" width="585" height="36" as="geometry"/></mxCell><mxCell id="step-7" value="&lt;span style=&quot;display:inline-block;box-sizing:border-box;width:19px;height:19px;border-radius:50%;text-align:center;line-height:19px;font-size:11px;font-weight:bold;vertical-align:middle;background:#FF9900;color:#232F3E;&quot;&gt;7&lt;/span&gt;&amp;nbsp; The Deploy stage rolls the service; Terraform ignores the new task definition." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;fontFamily=Helvetica;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="636" y="1017" width="585" height="36" as="geometry"/></mxCell><mxCell id="step-8" value="&lt;span style=&quot;display:inline-block;box-sizing:border-box;width:19px;height:19px;border-radius:50%;text-align:center;line-height:19px;font-size:11px;font-weight:bold;vertical-align:middle;background:#FF9900;color:#232F3E;&quot;&gt;8&lt;/span&gt;&amp;nbsp; Container Insights and logs land in CloudWatch; Datadog reads via a role and alerts to SNS." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;fontFamily=Helvetica;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="636" y="1059" width="585" height="36" as="geometry"/></mxCell><mxCell id="step-9" value="&lt;span style=&quot;display:inline-block;box-sizing:border-box;width:19px;height:19px;border-radius:50%;text-align:center;line-height:19px;font-size:11px;font-weight:bold;vertical-align:middle;background:#FF9900;color:#232F3E;&quot;&gt;9&lt;/span&gt;&amp;nbsp; The sidecar exposes MicroEnforcer, used as the app entrypoint for runtime protection." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;fontFamily=Helvetica;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="636" y="1101" width="585" height="36" as="geometry"/></mxCell><mxCell id="lines-title" value="&lt;b&gt;Line types&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;fontFamily=Helvetica;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1250" y="970" width="420" height="22" as="geometry"/></mxCell><mxCell id="key-app" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=7;dashed=0;strokeWidth=2;strokeColor=#232F3E;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1254" y="1008" as="sourcePoint"/><mxPoint x="1324" y="1008" as="targetPoint"/></mxGeometry></mxCell><mxCell id="key-app-t" value="application traffic" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;fontFamily=Helvetica;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1336" y="996" width="330" height="24" as="geometry"/></mxCell><mxCell id="key-cicd" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=7;dashed=1;dashPattern=8 4;strokeWidth=2;strokeColor=#545B64;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1254" y="1042" as="sourcePoint"/><mxPoint x="1324" y="1042" as="targetPoint"/></mxGeometry></mxCell><mxCell id="key-cicd-t" value="software delivery (CI/CD)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;fontFamily=Helvetica;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1336" y="1030" width="330" height="24" as="geometry"/></mxCell><mxCell id="key-telemetry" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=7;dashed=1;dashPattern=1 4;strokeWidth=2.5;strokeColor=#545B64;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1254" y="1076" as="sourcePoint"/><mxPoint x="1324" y="1076" as="targetPoint"/></mxGeometry></mxCell><mxCell id="key-telemetry-t" value="telemetry, runtime and alerts" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;fontFamily=Helvetica;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1336" y="1064" width="330" height="24" as="geometry"/></mxCell><mxCell id="key-iac" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=7;dashed=1;dashPattern=10 4 2 4;strokeWidth=2;strokeColor=#545B64;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1254" y="1110" as="sourcePoint"/><mxPoint x="1324" y="1110" as="targetPoint"/></mxGeometry></mxCell><mxCell id="key-iac-t" value="Terraform provisioning" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;fontFamily=Helvetica;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1336" y="1098" width="330" height="24" as="geometry"/></mxCell><mxCell id="key-opt" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;dashed=1;strokeWidth=1.4;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1254" y="1140" width="70" height="26" as="geometry"/></mxCell><mxCell id="key-opt-t" value="dashed card = optional, feature flag off by default" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;fontFamily=Helvetica;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1336" y="1141" width="360" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>